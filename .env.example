# --- MongoDB ---
# Lokal: mongodb://127.0.0.1:27017/tolov_tizimi
# Atlas: mongodb+srv://USER:PAROL@cluster0.xxxxx.mongodb.net/tolov_tizimi
MONGODB_URI=

# --- Kirish ---
# Admin paroli (saytga kirish uchun)
ADMIN_PASSWORD=
# Sessiya imzosi uchun tasodifiy uzun satr (kamida 32 belgi).
# Yaratish: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Yon menyuda ko'rinadigan markaz nomi (ixtiyoriy). Standart: Asosiy markaz
# CENTER_NAME=Chortoq filiali

# Tushumdan hisoblanadigan ulush foizi (jami summa ostida ko'rsatiladi). Standart: 40
# SHARE_PERCENT=40

# --- Kunlik Sheets tekshiruvi ---
# Tekshiruv soati, Toshkent vaqti bo'yicha (0-23). Standart: 6
SYNC_HOUR=6
# /api/cron/sync uchun maxfiy kalit (Vercel Cron shu kalitni avtomatik yuboradi)
CRON_SECRET=
# O'z serveringizda (VPS, `npm start`) ichki rejalashtiruvchi avtomatik ishlaydi.
# O'chirish kerak bo'lsa: INTERNAL_CRON=false
# INTERNAL_CRON=false

# Ixtiyoriy: Sheets havolasini sozlamalar sahifasi o'rniga shu yerda berish
# SHEET_URL=https://docs.google.com/spreadsheets/d/.../edit#gid=0

# --- Ixtiyoriy: maxfiy (yopiq) jadval uchun Google service account ---
# Bo'lmasa, jadval "Havolaga ega har kim ko'ra oladi" rejimida bo'lishi kerak.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=tolov-bot@loyiha.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
